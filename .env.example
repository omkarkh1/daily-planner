# Copy to .env (or set in your host's dashboard). Every value is optional.

# Port and interface to listen on.
PORT=3000
HOST=0.0.0.0

# Where the SQLite database lives. Back this file up (or use Export in the app).
DB_PATH=./data/cadence.db

# "true" when running behind a reverse proxy (Caddy, nginx, Fly.io, Render, Railway...)
# so client IPs and HTTPS are read from X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false

# Force the Secure cookie flag on or off. Unset = automatic (Secure whenever the request is HTTPS).
# COOKIE_SECURE=true

# How many days a device stays signed in after its last visit.
SESSION_DAYS=30

# One-time token for creating the account at /setup. Unset = random token printed in the log.
# SETUP_TOKEN=replace-with-a-long-random-string

# Name used as the issuer in authenticator apps.
APP_NAME=Cadence
